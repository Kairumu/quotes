rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validBookmarkKind() {
      return request.resource.data.kind in ['highlight', 'capture', 'page', 'book', 'collection'];
    }

    // ── Content (read-only for signed-in users, writes via admin SDK only) ──

    match /collections/{collectionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /books/{bookId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Translations written only by Cloud Functions (admin SDK bypasses rules)
    match /translations/{bookId}/chunks/{translationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── User data (owner-only) ──

    // Bookmarks with field validation on kind
    match /users/{uid}/bookmarks/{bookmarkId} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid) && validBookmarkKind();
      allow update: if isOwner(uid) && validBookmarkKind();
      allow delete: if isOwner(uid);
    }

    // Reading positions
    match /users/{uid}/positions/{bookId} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // Catch-all for any other user sub-paths
    match /users/{uid}/{rest=**} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid);
    }
  }
}
